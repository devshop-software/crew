{
  "name": "crew-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local dev tooling for crew — generates the Codex adapter and renders the canonical skills/agents to HTML. Not part of either shipped plugin.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node dev/build-codex.mjs && node dev/build.mjs",
    "build:codex": "node dev/build-codex.mjs",
    "check:codex": "node dev/build-codex.mjs --check && node dev/validate-codex.mjs",
    "watch": "node dev/watch.mjs",
    "serve": "node dev/serve.mjs",
    "dev": "node dev/dev.mjs"
  }
}
